FROM scratch

LABEL org.opencontainers.image.title="stormd"
LABEL org.opencontainers.image.description="Container init system for scratch images — process supervisor, REST API, SSH shell, logging, events"
LABEL org.opencontainers.image.source="https://github.com/glennswest/stormd"
LABEL org.opencontainers.image.vendor="stormd"

COPY target/x86_64-unknown-linux-musl/release/stormd /stormd
COPY target/x86_64-unknown-linux-musl/release/stormsh /stormsh

VOLUME /data/minio
VOLUME /var/log/stormd
EXPOSE 9080 9000 22

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/stormd", "--healthcheck"]

ENTRYPOINT ["/stormd"]
