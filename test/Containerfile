# stormd's test image, per stormcentral docs/test-standard.md: one image for
# every suite, started as `/test <suite>` (short, medium or long).
#
# Built with the repo root as context, after test/build.sh has put the two
# static (musl) binaries in test/out/: the stormd of the commit under test and
# the test program. The test runs /stormd as its child and drives it through
# its REST API; the processes it supervises are /test itself in helper mode,
# so the image needs nothing else.
FROM scratch
LABEL storm.io/test-of="stormd"
COPY test/out/stormd /stormd
COPY test/out/stormd-test /test
ENTRYPOINT ["/test"]
CMD ["short"]
